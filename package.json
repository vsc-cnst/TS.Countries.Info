{
  "name": "@vsc-cnst/countries-info",
  "version": "1.0.14",
  "description": "A TypeScript library that provides detailed information about countries, including their names, languages, translations, and other metadata.",
  "author": "vsc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsc-cnst/TS.Countries.Info.git"
  },
  "license": "MIT",
  "main": "dist/index.ts",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": false,
    "clean": true,
    "format": [
      "cjs",
      "esm",
      "iife"
    ],
    "target": [
      "esnext",
      "es2015"
    ],
    "dts": true,
    "minify": true,
    "tsconfig": "tsconfig.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm ci & npm run build"
  },
  "keywords": [
    "ts",
    "type",
    "types",
    "country",
    "countries",
    "info",
    "information",
    "code",
    "codes",
    "codes"
  ],
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
